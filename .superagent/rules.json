{
  "required_checks": [
    {
      "when": ["wetamp/**/*.ts", "wetamp/**/*.js", "wetamp/**/*.cjs", "wetamp/**/*.sh"],
      "check": { "cmd": "cd wetamp && bun run type-check", "timeout_s": 900 }
    },
    {
      "when": ["wetamp/**", "packages/**"],
      "check": {
        "cmd": "cd wetamp && bun run test",
        "timeout_s": 1800,
        "cache": true
      }
    }
  ]
}
