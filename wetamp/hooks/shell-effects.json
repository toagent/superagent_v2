[
  { "commands": ["rm", "rmdir"], "effect": "destroy", "targets": "operands" },
  { "commands": ["cp", "ln", "install", "rsync"], "effect": "overwrite", "targets": "last" },
  { "commands": ["mv"], "effect": "destroy", "targets": "operands" },
  {
    "commands": ["truncate", "tee"],
    "effect": "overwrite",
    "targets": "operands",
    "append": ["-a", "--append"]
  },
  { "commands": ["touch", "mkdir"], "effect": "create", "targets": "operands" },
  { "commands": ["dd"], "effect": "overwrite", "targets": "of" },
  {
    "commands": ["sed"],
    "pattern": "^-[^-]*i|^--in-place",
    "effect": "overwrite",
    "targets": "operands"
  },
  {
    "commands": ["sort"],
    "effect": "overwrite",
    "targets": "option",
    "options": ["-o", "--output"]
  },
  { "commands": ["find"], "pattern": "^-delete$", "effect": "destroy", "targets": "first" },
  {
    "commands": ["tar"],
    "pattern": "^-[^-]*x|^--extract$|^x",
    "effect": "write",
    "targets": "option",
    "options": ["-C", "--directory"],
    "default": "."
  },
  { "commands": ["sudo", "doas"], "effect": "elevate" },
  {
    "commands": ["codex", "claude", "opencode", "sol-run"],
    "commandPrefixes": ["twin-agent"],
    "effect": "delegate"
  },
  { "commands": ["pkill", "killall"], "effect": "process_selection" },
  { "commands": ["pgrep", "pidof", "lsof"], "effect": "process_query" },
  { "commands": ["kill"], "effect": "signal" },
  {
    "commands": ["security"],
    "pattern": "^(find-.*-password|dump-keychain|export)$",
    "effect": "credential"
  },
  { "commands": ["npm", "pnpm", "bun", "yarn"], "pattern": "^publish$", "effect": "external" },
  { "commands": ["docker"], "pattern": "^push$|^--push$", "effect": "external" },
  {
    "commands": ["gh"],
    "prefixes": [
      ["release", "create"],
      ["pr", "merge"],
      ["issue", "create"],
      ["issue", "comment"],
      ["pr", "comment"]
    ],
    "effect": "external"
  },
  {
    "commands": ["vercel", "netlify", "firebase"],
    "pattern": "^--prod$|^--production$|^deploy$",
    "effect": "external"
  },
  {
    "commands": ["kubectl"],
    "pattern": "^(apply|delete|replace|patch|create|scale|rollout)$",
    "effect": "external"
  },
  {
    "commands": ["curl", "wget"],
    "pattern": "^-[^-]*[dFT]|^--(data.*|form.*|upload-file|post-data|post-file)(=|$)|^(POST|PUT|PATCH|DELETE)$",
    "effect": "external"
  },
  { "commands": ["osascript"], "pattern": "\\bReminders\\b", "effect": "external" },
  {
    "commands": ["git"],
    "effect": "git",
    "destructive": {
      "clean": {
        "unless": "^--(?:d(?:r(?:y(?:-(?:r(?:u(?:n)?)?)?)?)?)?)(?:=|$)|^-[^-]*n"
      },
      "restore": {
        "unless": "^--staged$|^-S$"
      },
      "stash": {
        "pattern": "^(drop|clear)$"
      },
      "update-ref": {
        "pattern": "^-d$|^--delete$"
      },
      "prune": {},
      "rm": {
        "pattern": "^-[^-]*f|^--f(?:o(?:r(?:c(?:e)?)?)?)?$",
        "unless": "^--c(?:a(?:c(?:h(?:e(?:d)?)?)?)?)?$|^--dry-run$|^-[^-]*n"
      },
      "reflog": { "pattern": "^(delete|expire)$" },
      "gc": { "pattern": "^--p(?:r(?:u(?:n(?:e)?)?)?)?=(?:now|all|0)$" }
    },
    "destructiveFlags": {
      "reset": "^--(?:h(?:a(?:r(?:d)?)?)?|me(?:r(?:g(?:e)?)?)?|k(?:e(?:e(?:p)?)?)?)(?:=|$)",
      "checkout": "^-[^-]*f|^--(?:f(?:o(?:r(?:c(?:e)?)?)?)?|di(?:s(?:c(?:a(?:r(?:d(?:-(?:c(?:h(?:a(?:n(?:g(?:e(?:s)?)?)?)?)?)?)?)?)?)?)?)?)?)(?:=|$)|^--$",
      "switch": "^-[^-]*f|^--(?:f(?:o(?:r(?:c(?:e)?)?)?)?|di(?:s(?:c(?:a(?:r(?:d(?:-(?:c(?:h(?:a(?:n(?:g(?:e(?:s)?)?)?)?)?)?)?)?)?)?)?)?)?)(?:=|$)",
      "branch": "^-[^-]*[fC]|^--(?:fo(?:r(?:c(?:e)?)?)?|force-c(?:o(?:p(?:y)?)?)?)(?:=|$)",
      "tag": "^-[^-]*[df]|^--(?:d(?:e(?:l(?:e(?:t(?:e)?)?)?)?)?|fo(?:r(?:c(?:e)?)?)?)(?:=|$)",
      "fetch": "^-[^-]*f|^--(?:fo(?:r(?:c(?:e)?)?)?)(?:=|$)|^\\+",
      "checkout-index": "^-[^-]*f|^--(?:f(?:o(?:r(?:c(?:e)?)?)?)?)(?:=|$)"
    }
  }
]
