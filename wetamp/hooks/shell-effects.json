[
  {
    "commands": ["superagent"],
    "prefixes": [["run"], ["job", "exec"], ["quick"]],
    "effect": "delegate"
  },
  {
    "commands": [],
    "mcp": { "server": "twin-agent", "tools": ["delegate_agent"] },
    "effect": "delegate"
  },
  { "commands": [], "mcp": { "server": "claude", "tools": ["*"] }, "effect": "delegate" },
  {
    "commands": [],
    "mcp": {
      "server": "github",
      "tools": [
        "add_comment_to_pending_review",
        "add_issue_comment",
        "add_reply_to_pull_request_comment",
        "create_branch",
        "create_or_update_file",
        "create_pull_request",
        "create_repository",
        "delete_file",
        "fork_repository",
        "issue_write",
        "merge_pull_request",
        "pull_request_review_write",
        "push_files",
        "request_copilot_review",
        "sub_issue_write",
        "update_issue_comment",
        "update_pull_request",
        "update_pull_request_branch"
      ]
    },
    "effect": "external"
  },
  {
    "commands": [],
    "mcp": { "server": "serena", "tools": ["execute_shell_command"] },
    "effect": "execute"
  },
  {
    "commands": [],
    "mcp": {
      "server": "serena",
      "tools": [
        "replace_content",
        "replace_symbol_body",
        "insert_after_symbol",
        "insert_before_symbol",
        "rename_symbol",
        "create_text_file"
      ],
      "paths": ["relative_path", "path", "file_path"]
    },
    "effect": "write"
  },
  {
    "commands": [],
    "mcp": {
      "server": "filesystem",
      "tools": ["write_file", "edit_file", "create_directory", "move_file"],
      "paths": ["path", "source", "destination"]
    },
    "effect": "write"
  },
  { "commands": ["rm", "rmdir"], "effect": "destroy", "targets": "operands" },
  { "commands": ["cp", "ln", "install", "rsync"], "effect": "overwrite", "targets": "last" },
  { "commands": ["mv"], "effect": "destroy", "targets": "operands" },
  {
    "commands": ["truncate", "tee"],
    "effect": "overwrite",
    "targets": "operands",
    "append": ["-a", "--append"]
  },
  { "commands": ["touch", "mkdir"], "effect": "create", "targets": "operands" },
  { "commands": ["dd"], "effect": "overwrite", "targets": "of" },
  {
    "commands": ["sed"],
    "pattern": "^-[^-]*i|^--in-place",
    "effect": "overwrite",
    "targets": "operands"
  },
  {
    "commands": ["sort"],
    "effect": "overwrite",
    "targets": "option",
    "options": ["-o", "--output"]
  },
  { "commands": ["find"], "pattern": "^-delete$", "effect": "destroy", "targets": "first" },
  {
    "commands": ["tar"],
    "pattern": "^-[^-]*x|^--extract$|^x",
    "effect": "write",
    "targets": "option",
    "options": ["-C", "--directory"],
    "default": "."
  },
  { "commands": ["sudo", "doas"], "effect": "elevate" },
  {
    "commands": ["codex", "claude", "opencode", "sol-run"],
    "commandPrefixes": ["twin-agent"],
    "effect": "delegate"
  },
  { "commands": ["pkill", "killall"], "effect": "process_selection" },
  { "commands": ["pgrep", "pidof", "lsof"], "effect": "process_query" },
  { "commands": ["kill"], "effect": "signal" },
  {
    "commands": ["security"],
    "pattern": "^(find-.*-password|dump-keychain|export)$",
    "effect": "credential"
  },
  { "commands": ["npm", "pnpm", "bun", "yarn"], "pattern": "^publish$", "effect": "external" },
  { "commands": ["docker"], "pattern": "^push$|^--push$", "effect": "external" },
  {
    "commands": ["gh"],
    "prefixes": [
      ["release", "create"],
      ["pr", "merge"],
      ["issue", "create"],
      ["issue", "comment"],
      ["pr", "comment"]
    ],
    "effect": "external"
  },
  {
    "commands": ["vercel", "netlify", "firebase"],
    "pattern": "^--prod$|^--production$|^deploy$",
    "effect": "external"
  },
  {
    "commands": ["kubectl"],
    "pattern": "^(apply|delete|replace|patch|create|scale|rollout)$",
    "effect": "external"
  },
  {
    "commands": ["curl", "wget"],
    "pattern": "^-[^-]*[dFT]|^--(data.*|form.*|upload-file|post-data|post-file)(=|$)|^(POST|PUT|PATCH|DELETE)$",
    "effect": "external"
  },
  { "commands": ["osascript"], "pattern": "\\bReminders\\b", "effect": "external" },
  {
    "commands": ["git"],
    "effect": "git",
    "destructive": {
      "clean": {
        "unless": "^--(?:d(?:r(?:y(?:-(?:r(?:u(?:n)?)?)?)?)?)?)(?:=|$)|^-[^-]*n"
      },
      "restore": {
        "unless": "^--staged$|^-S$"
      },
      "stash": {
        "pattern": "^(drop|clear)$"
      },
      "update-ref": {
        "pattern": "^-d$|^--delete$"
      },
      "prune": {},
      "rm": {
        "pattern": "^-[^-]*f|^--f(?:o(?:r(?:c(?:e)?)?)?)?$",
        "unless": "^--c(?:a(?:c(?:h(?:e(?:d)?)?)?)?)?$|^--dry-run$|^-[^-]*n"
      },
      "reflog": { "pattern": "^(delete|expire)$" },
      "gc": { "pattern": "^--p(?:r(?:u(?:n(?:e)?)?)?)?=(?:now|all|0)$" }
    },
    "destructiveFlags": {
      "reset": "^--(?:h(?:a(?:r(?:d)?)?)?|me(?:r(?:g(?:e)?)?)?|k(?:e(?:e(?:p)?)?)?)(?:=|$)",
      "checkout": "^-[^-]*f|^--(?:f(?:o(?:r(?:c(?:e)?)?)?)?|di(?:s(?:c(?:a(?:r(?:d(?:-(?:c(?:h(?:a(?:n(?:g(?:e(?:s)?)?)?)?)?)?)?)?)?)?)?)?)?)(?:=|$)|^--$",
      "switch": "^-[^-]*f|^--(?:f(?:o(?:r(?:c(?:e)?)?)?)?|di(?:s(?:c(?:a(?:r(?:d(?:-(?:c(?:h(?:a(?:n(?:g(?:e(?:s)?)?)?)?)?)?)?)?)?)?)?)?)?)(?:=|$)",
      "branch": "^-[^-]*[fC]|^--(?:fo(?:r(?:c(?:e)?)?)?|force-c(?:o(?:p(?:y)?)?)?)(?:=|$)",
      "tag": "^-[^-]*[df]|^--(?:d(?:e(?:l(?:e(?:t(?:e)?)?)?)?)?|fo(?:r(?:c(?:e)?)?)?)(?:=|$)",
      "fetch": "^-[^-]*f|^--(?:fo(?:r(?:c(?:e)?)?)?)(?:=|$)|^\\+",
      "checkout-index": "^-[^-]*f|^--(?:f(?:o(?:r(?:c(?:e)?)?)?)?)(?:=|$)"
    }
  }
]
