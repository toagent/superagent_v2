[
  { "commands": ["rm", "rmdir"], "effect": "destroy", "targets": "operands" },
  { "commands": ["cp", "ln", "install", "rsync"], "effect": "overwrite", "targets": "last" },
  { "commands": ["mv"], "effect": "destroy", "targets": "operands" },
  {
    "commands": ["truncate", "tee"],
    "effect": "overwrite",
    "targets": "operands",
    "append": ["-a", "--append"]
  },
  { "commands": ["touch", "mkdir"], "effect": "create", "targets": "operands" },
  { "commands": ["dd"], "effect": "overwrite", "targets": "of" },
  {
    "commands": ["sed"],
    "pattern": "^-[^-]*i|^--in-place",
    "effect": "overwrite",
    "targets": "operands"
  },
  {
    "commands": ["sort"],
    "effect": "overwrite",
    "targets": "option",
    "options": ["-o", "--output"]
  },
  { "commands": ["find"], "pattern": "^-delete$", "effect": "destroy", "targets": "first" },
  {
    "commands": ["tar"],
    "pattern": "^-[^-]*x|^--extract$|^x",
    "effect": "write",
    "targets": "option",
    "options": ["-C", "--directory"],
    "default": "."
  },
  { "commands": ["sudo", "doas"], "effect": "elevate" },
  {
    "commands": ["codex", "claude", "opencode", "sol-run"],
    "commandPrefixes": ["twin-agent"],
    "effect": "delegate"
  },
  { "commands": ["pkill", "killall"], "effect": "process_selection" },
  { "commands": ["pgrep", "pidof", "lsof"], "effect": "process_query" },
  { "commands": ["kill"], "effect": "signal" },
  {
    "commands": ["security"],
    "pattern": "^(find-.*-password|dump-keychain|export)$",
    "effect": "credential"
  },
  { "commands": ["npm", "pnpm", "bun", "yarn"], "pattern": "^publish$", "effect": "external" },
  { "commands": ["docker"], "pattern": "^push$|^--push$", "effect": "external" },
  {
    "commands": ["gh"],
    "prefixes": [
      ["release", "create"],
      ["pr", "merge"],
      ["issue", "create"],
      ["issue", "comment"],
      ["pr", "comment"]
    ],
    "effect": "external"
  },
  {
    "commands": ["vercel", "netlify", "firebase"],
    "pattern": "^--prod$|^--production$|^deploy$",
    "effect": "external"
  },
  {
    "commands": ["kubectl"],
    "pattern": "^(apply|delete|replace|patch|create|scale|rollout)$",
    "effect": "external"
  },
  {
    "commands": ["curl", "wget"],
    "pattern": "^-[^-]*[dFT]|^--(data.*|form.*|upload-file|post-data|post-file)(=|$)|^(POST|PUT|PATCH|DELETE)$",
    "effect": "external"
  },
  { "commands": ["osascript"], "pattern": "\\bReminders\\b", "effect": "external" },
  {
    "commands": ["git"],
    "effect": "git",
    "read": [
      "status",
      "diff",
      "log",
      "show",
      "rev-parse",
      "ls-files",
      "ls-tree",
      "blame",
      "grep",
      "cat-file",
      "describe",
      "merge-base",
      "rev-list",
      "shortlog",
      "show-ref",
      "name-rev",
      "for-each-ref"
    ],
    "queries": {
      "branch": ["--list", "-l", "--show-current", "-a", "-r"],
      "tag": ["--list", "-l"],
      "remote": ["-v", "--verbose"],
      "config": ["--get", "--get-all", "--get-regexp", "--list", "-l"],
      "reflog": ["show"]
    },
    "mutationFlags": "^-[a-zA-Z]*[dDfFmMcC]$|^--(delete|force|move|copy|unset.*|add|replace-all|rename-section|remove-section)(=|$)",
    "forceFlags": "^-[a-zA-Z]*f[a-zA-Z]*$|^--force(?:-[a-z-]+)?(?:=|$)",
    "destructive": {
      "reset": {},
      "restore": {},
      "clean": {},
      "rebase": {},
      "update-ref": {},
      "prune": {},
      "gc": {},
      "checkout": { "unless": "^-b|^--orphan(?:=|$)" },
      "switch": { "unless": "^-c|^--create(?:=|$)" },
      "branch": { "pattern": "^-[a-zA-Z]*[dDmM][a-zA-Z]*$|^--(?:delete|move)(?:=|$)" },
      "tag": { "pattern": "^-[a-zA-Z]*d[a-zA-Z]*$|^--delete(?:=|$)" },
      "commit": { "pattern": "^--amend(?:=|$)" },
      "fetch": { "pattern": "^--prune(?:-tags)?(?:=|$)|^\\+" },
      "pull": { "pattern": "^-[a-zA-Z]*r[a-zA-Z]*$|^--rebase(?:=|$)" },
      "stash": { "pattern": "^(pop|drop|clear|branch)$" },
      "merge": { "pattern": "^--abort$" },
      "cherry-pick": { "pattern": "^--abort$" },
      "revert": { "pattern": "^--abort$" },
      "remote": { "pattern": "^(remove|rm|rename|set-url|prune)$" },
      "reflog": { "pattern": "^(delete|expire)$" },
      "worktree": { "pattern": "^(remove|move|prune)$" },
      "notes": { "pattern": "^(remove|prune)$" }
    },
    "destructiveFlags": {
      "branch": "^-C",
      "checkout": "^-B|^--discard-changes$|^--$",
      "switch": "^-C|^--force-create(?:=|$)|^--discard-changes$"
    }
  }
]
