(version 1)
(allow default)
(deny file-read* file-write*
  (subpath "__HOME_LITERAL__/Library/Mobile Documents")
  (regex #"^__HOME_REGEX__/Library/CloudStorage/[iI][cC][lL][oO][uU][dD]")
__SECRET_OS_DENIES__
  (regex #"(^|/)_private(/|$)"))
__SECRET_EXEC_DENIES__
(deny file-read* (literal "__HOME_LITERAL__/.wetamp/jail/.probe"))
(deny file-write* (subpath "__HOME_LITERAL__/.wetamp/jail"))
; setuid executables cannot start sandboxed; coord and hooks use ps for process identity.
(allow process-exec (literal "/bin/ps") (with no-sandbox))
; Sandboxed launchd rejects registration; console and supervise-tick require launchctl.
; Jobs it starts still use the ai-jail prefix. This only reduces accidental or indirect access.
(allow process-exec (literal "/bin/launchctl") (with no-sandbox))
