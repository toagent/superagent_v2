(version 1)
(allow default)
; 封锁 Clash 控制口，避免监控进程命令行中的令牌被用于控制 Clash。
(deny network-outbound (remote ip "localhost:9090"))
; 本机真实 seatbelt 实测按大小写不敏感匹配正则，保留字符类以在区分大小写的卷上仍能拒绝受保护路径。
(deny file-read* file-write*
  (subpath "__HOME_LITERAL__/Library/Mobile Documents")
  (regex #"^__HOME_REGEX__/Library/CloudStorage/[iI][cC][lL][oO][uU][dD]")
__SECRET_OS_DENIES__
  (require-all
    (require-not (regex #"^__HOME_REGEX__/[.]cache/uv/"))
    (require-any
      (require-all
        (regex #"(^|/)_[pP][rR][iI][vV][aA][tT][eE](/|$)")
        (require-not (regex #"/(node_modules|site-packages)/([^/]*/)*_[pP][rR][iI][vV][aA][tT][eE](/|$)")))
      (regex #"(^|/)_[pP][rR][iI][vV][aA][tT][eE]/([^/]*/)*(node_modules|site-packages)(/|$)"))))
; Keychain search list/default keychain writes go through cfprefsd, bypassing file rules.
(deny user-preference-write (preference-domain "com.apple.security"))
__SECRET_EXEC_DENIES__
__QUICKLOOK_DENY__
(deny file-write* (subpath "__HOME_LITERAL__/.vault-bridge/trust"))
(deny file-read* (literal "__HOME_LITERAL__/.wetamp/jail/.probe"))
(deny file-write* (subpath "__HOME_LITERAL__/.wetamp/jail"))
; setuid executables cannot start sandboxed; coord and hooks use ps for process identity.
(allow process-exec (literal "/bin/ps") (with no-sandbox))
; Sandboxed launchd rejects registration; console and supervise-tick require launchctl.
; Jobs it starts still use the ai-jail prefix. This only reduces accidental or indirect access.
(allow process-exec (literal "/bin/launchctl") (with no-sandbox))
