{
  "title": "CoderOutput",
  "type": "object",
  "properties": {
    "status": { "enum": ["done", "blocked", "partial"] },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "quick_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "cmd": { "type": "string" }, "exit": { "type": "integer" } },
        "required": ["cmd", "exit"]
      }
    },
    "notes": { "type": "string" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "error_class": {
      "description": "仅在未完成（partial/blocked/error）时填写失败类别；status=done 时必须为 null",
      "type": ["string", "null"],
      "enum": [
        "scope_violation",
        "budget_exhausted",
        "plan_invalid",
        "sandbox_denied",
        "permission_denied",
        "vendor_unavailable_all",
        "task",
        "env",
        "timeout",
        "redline",
        null
      ]
    },
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "path": { "type": "string" }, "why": { "type": "string" } },
        "required": ["path", "why"]
      }
    },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cap": { "type": "string" },
          "why": { "type": "string" },
          "minimal_ask": { "type": "string" }
        },
        "required": ["cap", "why", "minimal_ask"]
      }
    }
  },
  "required": [
    "status",
    "changed_files",
    "quick_checks",
    "notes",
    "blockers",
    "error_class",
    "deviations",
    "needs"
  ]
}
