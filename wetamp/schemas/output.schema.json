{
  "$comment": "Node output_format (AI nodes; accept/head are deterministic sa-check/bash nodes). Codex strict mode: every key required, optional values as null unions, no length/range keywords. Field set is v2 coder/reviewer results flattened (anyOf → single branch) plus reviewer debt.",
  "$defs": {
    "failure_class": {
      "type": "string",
      "enum": ["product", "test_env", "fixture", "baseline", "test_data", "unknown"]
    },
    "coder": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["done", "blocked", "partial"]
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "quick_checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string"
              },
              "exit": {
                "type": "integer"
              }
            },
            "required": ["cmd", "exit"]
          }
        },
        "notes": {
          "type": "string"
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error_class": {
          "description": "仅在未完成（partial/blocked/error）时填写失败类别；status=done 时必须为 null",
          "type": ["string", "null"],
          "enum": [
            "scope_violation",
            "budget_exhausted",
            "plan_invalid",
            "sandbox_denied",
            "permission_denied",
            "vendor_unavailable_all",
            "task",
            "env",
            "timeout",
            "redline",
            null
          ]
        },
        "deviations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": ["path", "why"]
          }
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cap": {
                "type": "string"
              },
              "why": {
                "type": "string"
              },
              "minimal_ask": {
                "type": "string"
              }
            },
            "required": ["cap", "why", "minimal_ask"]
          }
        }
      },
      "required": [
        "status",
        "changed_files",
        "quick_checks",
        "notes",
        "blockers",
        "error_class",
        "deviations",
        "needs"
      ]
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PASS", "FAIL", "INCOMPLETE"]
        },
        "notes": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "severity": {
                "type": "string",
                "enum": ["blocker", "high", "medium", "low"]
              },
              "file": {
                "type": "string"
              },
              "line": {
                "type": "integer"
              },
              "status": {
                "type": "string",
                "enum": ["open", "closed"]
              },
              "evidence": {
                "type": "string"
              },
              "failure_class": {
                "type": "string",
                "enum": ["product", "test_env", "fixture", "baseline", "test_data", "unknown"]
              },
              "command": { "type": ["string", "null"] },
              "carry_over": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "severity",
              "file",
              "line",
              "status",
              "evidence",
              "carry_over",
              "failure_class",
              "command"
            ]
          }
        },
        "fixture_confirmations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "isolated_fixture": {
                "type": "boolean"
              },
              "no_data_operations": {
                "type": "boolean"
              },
              "evidence": {
                "type": "string"
              }
            },
            "required": ["path", "purpose", "isolated_fixture", "no_data_operations", "evidence"]
          }
        },
        "debt": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["status", "notes", "findings", "fixture_confirmations", "debt"]
    },
    "accept": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "object",
          "properties": {
            "kind": { "enum": ["advance", "debt", "repair", "block"] },
            "reason": { "type": ["string", "null"] },
            "evidence": { "type": "array", "items": { "type": "string" } },
            "debt": { "type": "array", "items": { "type": "string" } },
            "requirements": {
              "type": "object",
              "required": ["status", "items"],
              "properties": {
                "status": { "enum": ["legacy", "verified", "unmet", "unknown"] },
                "items": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["package", "id", "text", "status", "evidence"],
                    "properties": {
                      "package": { "type": "string" },
                      "id": { "type": "string" },
                      "text": { "type": "string" },
                      "status": { "enum": ["verified", "unmet", "unknown"] },
                      "evidence": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          },
          "required": ["kind", "reason", "evidence", "debt"]
        },
        "workspace_clean": { "type": "boolean" },
        "failures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "command": { "type": "string" },
              "failure_class": {
                "type": "string",
                "enum": ["product", "test_env", "fixture", "baseline", "test_data", "unknown"]
              },
              "evidence": { "type": "string" },
              "failed_tests": { "type": "array", "items": { "type": "string" } },
              "failure_digest": { "type": "string" },
              "adjudicated": { "type": "boolean" }
            },
            "required": ["command", "failure_class", "evidence"]
          }
        },
        "coder_partial": { "type": "boolean" },
        "self_report_conflict": { "type": "boolean" },
        "error_class_ignored": { "type": "boolean" },
        "ok": {
          "type": "boolean"
        },
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "log": {
          "type": "string"
        },
        "patch": {
          "type": "string"
        },
        "diff_hash": {
          "type": "string"
        },
        "same": {
          "type": "boolean"
        },
        "reviewed": {
          "type": "boolean"
        },
        "base_pass": {
          "type": ["boolean", "null"]
        },
        "checkout_fingerprint": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "disposition": {
          "enum": ["advance", "repair", "adjudicate", "fail", "suspend"]
        },
        "adjudication": {
          "type": "object",
          "required": [
            "diff_hash",
            "contract_hash",
            "command",
            "failed_tests",
            "failure_digest",
            "report",
            "counts",
            "known",
            "cases"
          ],
          "properties": {
            "diff_hash": { "type": "string" },
            "contract_hash": { "type": "string" },
            "command": { "type": "string" },
            "failed_tests": { "type": "array", "items": { "type": "string" } },
            "failure_digest": { "type": "string" },
            "report": { "type": "string" },
            "counts": { "type": "object" },
            "known": { "type": "array" },
            "cases": { "type": "array" }
          }
        },
        "reason": {
          "type": ["string", "null"]
        },
        "delta": {
          "type": "string"
        },
        "risk": {
          "type": ["string", "null"]
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "ok",
        "failed",
        "log",
        "patch",
        "diff_hash",
        "same",
        "reviewed",
        "base_pass",
        "head",
        "checkout_fingerprint",
        "disposition",
        "reason",
        "delta",
        "risk",
        "out_of_scope",
        "decision"
      ]
    },
    "delivery": {
      "type": "object",
      "properties": {
        "diff_hash": { "type": "string" },
        "head": { "type": "string" }
      },
      "required": ["diff_hash"]
    },
    "head": {
      "type": "object",
      "properties": {
        "head": {
          "type": "string"
        }
      },
      "required": ["head"]
    },
    "attempt": {
      "type": "object",
      "properties": {
        "attempt": {
          "type": "string"
        }
      },
      "required": ["attempt"]
    }
  }
}
