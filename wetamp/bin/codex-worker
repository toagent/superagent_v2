#!/usr/bin/env bash
# Archon worker 的 Codex 二进制（assistants.codex.codexBinaryPath）：exec 真 codex，前置
# policy.exec_profiles.{coder,reviewer}.codex 的 -c 覆盖，并关闭沙箱清单外的已声明 MCP server。
# 只读 config.toml 的 [mcp_servers.<name>] 表头，不读取任何值（值里可能有凭据）。
set -euo pipefail
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"; [[ $src == /* ]] || src="$dir/$src"
done
self="$(cd -P "$(dirname "$src")" && pwd)/$(basename "$src")"
WETAMP="$(cd -P "$(dirname "$src")/.." && pwd)"
real="${SA_CODEX_REAL:-}"
if [ -z "$real" ]; then
  while IFS= read -r c; do
    [ "$(realpath "$c")" = "$self" ] && continue
    real="$c"; break
  done < <(type -ap codex)
fi
[ -n "$real" ] || { echo "codex-worker: real codex not found on PATH (set SA_CODEX_REAL)" >&2; exit 127; }
read -r -d '' JS <<'JS' || true
const fs = require('node:fs');
const [tiers, config] = process.argv.slice(1);
const {policy} = JSON.parse(fs.readFileSync(tiers, 'utf8'));
const settings = {};
for (const role of ['coder', 'reviewer'])
  for (const [k, v] of Object.entries(policy.exec_profiles[role].codex ?? {})) {
    if (k in settings && JSON.stringify(settings[k]) !== JSON.stringify(v)) throw new Error(`exec_profiles coder/reviewer disagree on codex ${k}`);
    settings[k] = v;
  }
const args = Object.entries(settings).flatMap(([k, v]) => ['-c', `${k}=${JSON.stringify(v)}`]);
let text = '';
try { text = fs.readFileSync(config, 'utf8'); } catch (e) { if (e.code !== 'ENOENT') throw e; }
const declared = new Set([...text.matchAll(/^\s*\[\s*mcp_servers\.(?:"([^"]+)"|([A-Za-z0-9_-]+))/gm)].map(m => m[1] ?? m[2]));
for (const name of declared) if (!policy.sandbox.mcp.includes(name)) args.push('-c', `mcp_servers.${/^[A-Za-z0-9_-]+$/.test(name) ? name : JSON.stringify(name)}.enabled=false`);
if (args.some(a => a.includes('\n'))) throw new Error('codex-worker: newline in generated argument');
process.stdout.write(args.join('\n'));
JS
# 逐行一个参数；node 失败时命令替换让 set -e 终止，不带半套覆盖启动 codex。
out="$(node -e "$JS" "$WETAMP/tiers.json" "${CODEX_HOME:-$HOME/.codex}/config.toml")"
extra=()
while IFS= read -r a; do [ -n "$a" ] && extra+=("$a"); done <<< "$out"
argv=("$real" ${extra[@]+"${extra[@]}"} "$@")
if [ "${SA_CODEX_WORKER_TRACE:-}" = 1 ]; then
  node -e 'process.stderr.write(JSON.stringify(process.argv.slice(1)) + "\n")' -- "${argv[@]}"
fi
exec "${argv[@]}"
