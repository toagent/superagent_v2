#!/usr/bin/env bash
set -euo pipefail

sa_home=${SUPERAGENT_HOME:-$HOME/.superagent}
archon_home=${ARCHON_HOME:-$sa_home/archon}
jail="$HOME/.wetamp/jail"
# `secret` manages the user's keychain and must run outside the jail when a person invokes it
# from a normal terminal; inside an AI session the probe is unreadable, so nothing escapes here.
if [[ -f "$jail/installed" && "${1:-}" != secret ]]; then
  if [[ -r "$jail/.probe" ]]; then
    source "$(dirname "$(realpath "$0")")/secret-env.sh"
    inject_managed_secrets superagent-shim
    exec "$jail/ai-jail" "$0" "$@"
  elif ! command ls -A "$jail" 2>/dev/null | command grep -Fxq .probe; then
    source "$(dirname "$(realpath "$0")")/secret-env.sh"
    inject_managed_secrets superagent-shim
    exec "$jail/ai-jail" "$0" "$@"
  fi
fi
export SUPERAGENT_HOME=$sa_home
export ARCHON_HOME=$archon_home
engine_home="$sa_home/engine"
self_root=$(cd "$(dirname "$0")/../.." && pwd -P)
current=$(readlink "$engine_home/current" 2>/dev/null || true)
if [[ -n "$current" && "$current" != /* ]]; then current="$engine_home/$current"; fi
current=${current:-$self_root}

run_cli() {
  local snapshot=$1
  shift
  exec bun "$snapshot/wetamp/src/cli.ts" "$@"
}

terminal_runs() {
  local id status
  for id in "$@"; do
    status=$(SA_HISTORICAL_RUN="$id" bun "$current/wetamp/src/cli.ts" status "$id" 2>/dev/null || true)
    bun -e 'const v=JSON.parse(await Bun.stdin.text());process.exit(["completed","failed","cancelled"].includes(v.state)?0:1)' <<< "$status" || return 1
  done
}

verb=${1:-}
if [[ "$verb" == supervise-tick ]]; then
  schedule=$(bun "$current/wetamp/src/cli.ts" supervise-tick --schedule)
  printf '%s\n' "$schedule"
  tick_status=0
  while IFS=$'\t' read -r snapshot ids; do
    [[ -n "$snapshot" && -n "$ids" ]] || continue
    IFS=',' read -r -a run_ids <<< "$ids"
    args=(supervise-tick --no-global)
    for run in "${run_ids[@]}"; do args+=(--runs "$run"); done
    if [[ ! -d "$snapshot" ]]; then
      printf 'engine snapshot unavailable; run superagent engine adopt %s <sha>\n' "${run_ids[0]}" >&2
      tick_status=1
      continue
    fi
    if ! SA_SERVED_RUN="${run_ids[0]}" bun "$snapshot/wetamp/src/cli.ts" "${args[@]}"; then
      tick_status=1
    fi
  done < <(bun -e '
    const chunks = await Bun.stdin.text();
    const lines = chunks.trim().split("\n");
    const value = JSON.parse(lines.at(-1) || "{}");
    for (const group of value.groups || []) console.log(`${group.snapshot}\t${group.runs.join(",")}`);
  ' <<< "$schedule")
  exit "$tick_status"
fi

wait_runs=()
if [[ "$verb" == wait ]]; then
  for arg in "${@:2}"; do [[ "$arg" == --* ]] && break; wait_runs+=("$arg"); done
  if [[ "${#wait_runs[@]}" -gt 1 ]]; then
    routes=$(bun -e '
      const home=process.argv[1],engine=process.argv[2],groups=new Map(),fs=require("node:fs");
      const receipts=Array.from(new Bun.Glob("*.json").scanSync(`${engine}/receipts`)).flatMap(file=>{
        try{return [JSON.parse(fs.readFileSync(`${engine}/receipts/${file}`,"utf8"))]}catch{return []}
      }).sort((a,b)=>a.at.localeCompare(b.at));
      for (const run of process.argv.slice(3)) {
        try { const l=JSON.parse(await Bun.file(`${home}/runs/${run}.json`).text()),s=l.engine_snapshot||(receipts[0]&&`${engine}/${receipts[0].sha}`);
          if(s) groups.set(s,[...(groups.get(s)||[]),run]); } catch {}
      }
      for(const [snapshot,runs] of groups) console.log(`${snapshot}\t${runs.join(",")}`);
    ' "$sa_home" "$engine_home" "${wait_runs[@]}")
    if [[ $(awk 'END { print NR }' <<< "$routes") -gt 1 ]]; then
      if terminal_runs "${wait_runs[@]}"; then
        export SA_HISTORICAL_RUN=${wait_runs[0]}
        run_cli "$current" "$@"
      fi
      printf 'wait runs use different engine snapshots; wait for each group separately:\n%s\n' "$routes" >&2
      exit 1
    fi
  fi
fi

run=${2:-}
continuation=0
if [[ "$verb" == resume || "$verb" == recover || ( "$verb" == decide && "${3:-}" == retry ) ]]; then
  continuation=1
fi
if [[ "$continuation" == 1 && -n "$run" && "$run" != --* && -f "$sa_home/runs/$run.json" ]]; then
  if route=$(bun "$current/wetamp/src/cli.ts" engine continuation "$run" 2>/dev/null) &&
    bun -e 'const value=JSON.parse(await Bun.stdin.text()); process.exit(value.current === true ? 0 : 1)' <<< "$route"
  then
    run_cli "$current" "$@"
  fi
fi

case "$verb" in
  wait|resume|recover|decide|land|cancel|brief|accept|status)
    run=${2:-}
    if [[ -n "$run" && "$run" != --* && -f "$sa_home/runs/$run.json" ]]; then
      snapshot=$(bun -e '
        const value = JSON.parse(await Bun.file(process.argv[1]).text());
        if (value.engine_snapshot) process.stdout.write(value.engine_snapshot);
        else {
          const dir = process.argv[2];
          const receipts = Array.from(new Bun.Glob("*.json").scanSync(dir)).flatMap(file => {
            try { return [JSON.parse(require("node:fs").readFileSync(`${dir}/${file}`, "utf8"))]; }
            catch { return []; }
          }).sort((a, b) => a.at.localeCompare(b.at));
          if (receipts[0]) process.stdout.write(`${process.argv[3]}/${receipts[0].sha}`);
        }
      ' "$sa_home/runs/$run.json" "$engine_home/receipts" "$engine_home")
      if [[ -n "$snapshot" ]]; then
        if [[ ! -d "$snapshot" ]]; then
          historical=0
          case "$verb" in
            wait)
              terminal_runs "${wait_runs[@]}" && historical=1 ;;
            brief|status|report) historical=1 ;;
            land)
              historical=1
              for arg in "$@"; do [[ "$arg" == --apply ]] && historical=0; done
              ;;
          esac
          if [[ "$historical" == 1 ]]; then
            export SA_HISTORICAL_RUN=$run
            run_cli "$current" "$@"
          fi
          printf 'engine snapshot unavailable; run superagent engine adopt %s <sha>\n' "$run" >&2
          exit 1
        fi
        export SA_SERVED_RUN=$run
        run_cli "$snapshot" "$@"
      fi
    fi
    ;;
esac
run_cli "$current" "$@"
