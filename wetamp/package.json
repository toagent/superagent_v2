{
  "name": "@wetamp/superagent",
  "private": true,
  "type": "module",
  "dependencies": {
    "@archon/workflows": "workspace:*",
    "ink": "^8.0.0",
    "react": "^19.3.0",
    "tree-sitter-bash": "0.25.1",
    "web-push": "3.6.7",
    "web-tree-sitter": "0.27.1"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "11.9.3",
    "@types/react": "^19.3.0",
    "@types/web-push": "3.6.4",
    "json-schema-to-typescript": "16.0.0"
  },
  "scripts": {
    "generate:golden": "bun scripts/generate-golden.ts",
    "generate:reasons": "bun scripts/generate-reasons.ts",
    "generate:failure-class": "bun scripts/generate-failure-class.ts",
    "generate:node-contracts": "bun scripts/generate-node-contracts.ts",
    "check:node-contracts": "bun scripts/generate-node-contracts.ts --check",
    "test": "bun run ../scripts/package-tests.ts",
    "type-check": "tsc --noEmit --incremental false -p tsconfig.json",
    "generate:plan-types": "bun scripts/generate-plan-schema.ts",
    "check:plan-types": "bun scripts/generate-plan-schema.ts --check"
  },
  "testGroups": [
    [
      "--parallel",
      "tests/",
      "scripts/"
    ]
  ]
}
